# ========================================================
# Kamis Docs — Configuration de l'Environnement
# ========================================================

# Port du serveur (défaut: 5000)
PORT=5000
NODE_ENV=development

# URLs publiques officielles de l'application
CLIENT_URL=https://kamis-docs.onrender.com
API_URL=https://kamis-docs.onrender.com

# Quota et Limites
MAX_FILE_SIZE_BYTES=104857600
DEFAULT_QUOTA_BYTES=5368709120

# Chemins de données
DATA_DIR=data
DB_PATH=data/kamis_docs.db
STORAGE_DIR=data/storage

# ========================================================
# Configuration Messagerie SMTP (Optionnel)
# ========================================================
# Laissez vide pour utiliser la boîte de messagerie locale intégrée.
# Pour envoyer de vrais courriels à votre adresse (Gmail, Brevo, Outlook, etc.) :
#
# Exemple Gmail (nécessite un "Mot de passe d'application" Google) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.email@gmail.com
# SMTP_PASS=votre_mot_de_passe_d_application_16_caracteres
# SMTP_FROM="Kamis Docs <votre.email@gmail.com>"
#
# Exemple Brevo (ex-Sendinblue) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre_identifiant_brevo
# SMTP_PASS=votre_cle_smtp_brevo
# SMTP_FROM="Kamis Docs <contact@votre-domaine.com>"
